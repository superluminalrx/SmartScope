{
  "Comment": "SmartScope -> Doppio preprocessing flow. Transfer frames to HPC, run Doppio Live via Globus Compute, transfer results back.",
  "StartAt": "TransferToHPC",
  "States": {
    "TransferToHPC": {
      "Comment": "Transfer frames + manifest from microscope DTN to HPC",
      "Type": "Action",
      "ActionUrl": "https://transfer.actions.globus.org/transfer",
      "ActionScope": "urn:globus:auth:scope:transfer.api.globus.org:all",
      "Parameters": {
        "source_endpoint.$": "$.input.source_collection",
        "destination_endpoint.$": "$.input.destination_collection",
        "DATA.$": "$.input.transfer_items",
        "label.$": "$.input.label"
      },
      "ResultPath": "$.TransferToHPC",
      "Next": "RunDoppio"
    },
    "RunDoppio": {
      "Comment": "Run Doppio Live processing via Globus Compute on HPC",
      "Type": "Action",
      "ActionUrl": "https://compute.actions.globus.org",
      "ActionScope": "https://auth.globus.org/scopes/facd7ccc-c5f4-42aa-916b-a0e270e2c2a9/all",
      "Parameters": {
        "endpoint.$": "$.input.compute_endpoint",
        "function.$": "$.input.compute_function_id",
        "kwargs.$": "$.input.compute_kwargs"
      },
      "ResultPath": "$.ComputeResult",
      "Next": "TransferResultsBack"
    },
    "TransferResultsBack": {
      "Comment": "Transfer processed results from HPC back to DTN",
      "Type": "Action",
      "ActionUrl": "https://transfer.actions.globus.org/transfer",
      "ActionScope": "urn:globus:auth:scope:transfer.api.globus.org:all",
      "Parameters": {
        "source_endpoint.$": "$.input.destination_collection",
        "destination_endpoint.$": "$.input.source_collection",
        "DATA.$": "$.input.return_transfer_items",
        "label": "Doppio results -> SmartScope"
      },
      "ResultPath": "$.TransferBack",
      "End": true
    }
  }
}
