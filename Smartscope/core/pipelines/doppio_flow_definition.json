{
  "Comment": "SmartScope -> Doppio preprocessing flow. Transfer frames to HPC, wait for Doppio to process, transfer results back.",
  "StartAt": "TransferToHPC",
  "States": {
    "TransferToHPC": {
      "Comment": "Transfer frames + manifest from microscope DTN to HPC",
      "Type": "Action",
      "ActionUrl": "https://transfer.actions.globus.org/transfer",
      "ActionScope": "urn:globus:auth:scope:transfer.api.globus.org:all",
      "Parameters": {
        "source_endpoint.$": "$.input.source_collection",
        "destination_endpoint.$": "$.input.destination_collection",
        "DATA.$": "$.input.transfer_items",
        "label.$": "$.input.label"
      },
      "ResultPath": "$.TransferToHPC",
      "Next": "WaitForProcessing"
    },
    "WaitForProcessing": {
      "Comment": "Wait for Doppio orchestrator to signal completion via resume API",
      "Type": "Wait",
      "Seconds": 86400,
      "Next": "CheckProcessingStatus"
    },
    "CheckProcessingStatus": {
      "Comment": "Check if processing succeeded before transferring results back",
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.ProcessingResult.details.status",
          "StringEquals": "completed",
          "Next": "TransferResultsBack"
        }
      ],
      "Default": "ProcessingFailed"
    },
    "TransferResultsBack": {
      "Comment": "Transfer .done.json and processed results from HPC back to DTN",
      "Type": "Action",
      "ActionUrl": "https://transfer.actions.globus.org/transfer",
      "ActionScope": "urn:globus:auth:scope:transfer.api.globus.org:all",
      "Parameters": {
        "source_endpoint.$": "$.input.destination_collection",
        "destination_endpoint.$": "$.input.source_collection",
        "DATA.$": "$.input.return_transfer_items",
        "label": "Doppio results -> SmartScope"
      },
      "ResultPath": "$.TransferBack",
      "End": true
    },
    "ProcessingFailed": {
      "Comment": "Processing failed — end without return transfer",
      "Type": "Fail",
      "Error": "DoppioProcessingFailed",
      "Cause": "Doppio processing did not complete successfully"
    }
  }
}
